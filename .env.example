# Required for the browser Realtime experience. Keep the real value server-side.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Local application settings.
DATABASE_PATH=./data/turno.sqlite
CLINIC_TIMEZONE=America/Los_Angeles

# Optional clinic-information search.
EXA_ENABLED=false
EXA_API_KEY=
EXA_ALLOWED_DOMAINS=

# Optional inbound phone adapter. Keep disabled until the browser path is stable.
TELEPHONY_ENABLED=false
SIP_WEBHOOK_SECRET=
